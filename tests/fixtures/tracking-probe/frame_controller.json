{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "name": "Overlay tracking capability probe",
  "description": "Read-only tracking diagnostic",
  "bindings": {
    "/actions/fingers": {
      "skeleton": [
        {
          "path": "/user/hand/left/input/skeleton/left",
          "output": "/actions/fingers/in/left"
        },
        {
          "path": "/user/hand/right/input/skeleton/right",
          "output": "/actions/fingers/in/right"
        }
      ]
    }
  }
}
